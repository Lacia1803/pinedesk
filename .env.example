# ==============================================================================
#  MAU FILE CAU HINH MOI TRUONG
#  Copy file nay thanh .env roi dien gia tri that vao
#    cp .env.example .env
# ==============================================================================

# ---------- Cong truy cap ----------
HTTP_PORT=8080
HTTPS_PORT=8443

# ---------- Co so du lieu MariaDB ----------
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi_user
GLPI_DB_PASSWORD=<DOI_MAT_KHAU_MANH_TAI_DAY>

# Mat khau root MariaDB (dung de sao luu / phuc hoi)
DB_ROOT_PASSWORD=<DOI_MAT_KHAU_MANH_TAI_DAY>

# ---------- Redis Cache ----------
REDIS_PASSWORD=<DOI_MAT_KHAU_MANH_TAI_DAY>

# ---------- Mui gio ----------
APP_TIMEZONE=Asia/Ho_Chi_Minh
