# ==============================================================================
#  CAC FILE KHONG DUOC DUA LEN GIT
#  Ly do: chua thong tin bi mat, mat khau, du lieu nguoi dung
# ==============================================================================

# File cau hinh chua mat khau - TUYET DOI khong commit
.env
.env.*
!.env.example

# Chung chi SSL (bi mat rieng tu cua he thong)
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem
nginx/ssl/*.csr
# Ban cu cua chung chi (start.sh tu dong sao luu khi sinh lai) - cung bi mat
nginx/ssl/*.bak
nginx/ssl/*.old

# Cac ban sao luu co so du lieu
backup/*.sql
backup/*.tar.gz
backup/*.zip

# Log
*.log
logs/

# File tam cua he dieu hanh
.DS_Store
Thumbs.db
desktop.ini

# File cua trinh soan thao
*.swp
*.swo
*~

# Thu muc tai nguyen tam
node_modules/
vendor/
.cache/

# Bytecode Python (sinh tu dong, khong can version)
__pycache__/
*.pyc

# Thu muc lam viec tam cua cac script dich / kiem tra / chup anh
#   (dung wildcard de khong sot khi them thu muc .tmp-* moi)
.tmp-*/

# Workspace tam cua cong cu thiet ke va Playwright
.impeccable/
.playwright-mcp/

# Anh chup nghiem thu vut tam o goc repo (anh that cua du an nam trong
# landing/ va plugins/, khong bi mau nay dung toi)
/*.png

# Thu muc lam viec tam cua chuoi script dich tieng Viet.
#   - 2 file .po nguon (vi_VN.po, fr_FR.po): TAI LAI DUOC tu container
#     -> bash scripts/cai-ban-dich.sh tai
#   - 7 file .mo: SAN PHAM SINH RA, khong bao gio sua tay
# => Khong version hoa (truoc day co '!/.tmp-locale/' nen ca 9 file bi commit
#    nham, trong do .po nang ~2 MB va .mo la rac sinh ra).
# Cac script tu dong tai .po khi thieu -> khong anh huong cai dat.
.tmp-locale/

# Ban sao luu tam cua landing page (giu tren dia, khong can version)
.backup-landing-cu/
