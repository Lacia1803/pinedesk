# ==============================================================================
#  CAU HINH CHUNG CHI SSL TU KY (self-signed) CHO PINEDESK
# ==============================================================================
#  Dung cho: openssl req -x509 ... -config nginx/ssl/openssl-san.cnf
#
#  VI SAO CAN FILE NAY?
#    Tuy chon -subj cua openssl KHONG dat duoc Subject Alternative Name (SAN).
#    Trinh duyet hien dai (Chrome/Firefox/Edge) BO QUA Common Name va CHI doc
#    SAN. Thieu SAN => canh bao nang hon, khong the them ngoai le.
#
#  MUC SAN (cac ten mien/IP ma chung chi hop le):
#    - localhost, pinedesk.local  : truy cap qua ten mien noi bo
#    - 127.0.0.1, ::1             : truy cap qua dia chi loopback
#    - *.localhost                : ten phu cua localhost
#    - 192.168.x.x / 10.x.x.x     : them IP LAN that neu can (sua ben duoi)
# ==============================================================================

[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_req

[ dn ]
C  = VN
ST = LamDong
L  = Da Lat
O  = Do An PineDesk
CN = pinedesk.local

[ v3_req ]
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName   = @san

[ san ]
DNS.1 = localhost
DNS.2 = pinedesk.local
DNS.3 = *.localhost
IP.1  = 127.0.0.1
IP.2  = ::1
